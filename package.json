{
  "name": "my-wedding-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "create-no-jekyll": "echo > dist/.nojekyll",
    "deploy": "run-s build create-no-jekyll"
  },
  "dependencies": {
    "firebase": "^12.6.0",
    "gsap": "^3.14.2",
    "ismobilejs": "^1.1.1",
    "jalutils": "^1.0.0",
    "luxon": "^3.7.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.1.4",
    "@types/luxon": "^3.2.0",
    "@types/node": "^25.0.2",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.6.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.7.4",
    "sass": "^1.96.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vue-tsc": "^3.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
